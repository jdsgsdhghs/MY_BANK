# Copy to .env on the production server and fill in real values.
APP_SECRET=change_this_to_a_long_random_string
JWT_PASSPHRASE=change_this_jwt_passphrase

MYSQL_DATABASE=mybank
MYSQL_USER=mybank_user
MYSQL_PASSWORD=change_this_db_password
MYSQL_ROOT_PASSWORD=change_this_root_password

# Where the API regex will allow CORS from (use full origin, escape dots)
CORS_ALLOW_ORIGIN=^https?://mybank\.example\.com$

# Ports exposed on the host
BACKEND_PORT=8080
FRONTEND_PORT=80

# Image refs
BACKEND_IMAGE=ghcr.io/jdsgsdhghs/mybank-backend:latest
FRONTEND_IMAGE=ghcr.io/jdsgsdhghs/mybank-frontend:latest
