# ============================================================================
# Production auto-hébergée (docker-compose.prod.yml) — copier vers .env
# Pour Render/Vercel : ces variables se définissent dans leurs dashboards.
# ============================================================================

# php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=change_this_to_a_long_random_string

# MySQL managé externe (jamais de MySQL conteneurisé en production)
DATABASE_URL=mysql://user:password@host:port/dbname?serverVersion=8.0&charset=utf8mb4

# JWT
JWT_PASSPHRASE=change_this_jwt_passphrase
# Clés persistantes (recommandé) : base64 -w0 config/jwt/private.pem
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=

# Origine du frontend Vercel (regex, échapper les points)
CORS_ALLOW_ORIGIN=^https://mybank-frontend\.vercel\.app$

# Port exposé sur l'hôte pour l'API
BACKEND_PORT=8080

# Proxys de confiance (laisser tel quel derrière le nginx du compose)
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
