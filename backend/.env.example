# ============================================================================
# MyBank backend — variables d'environnement
# Copier vers .env.local (dev) — en production, définir ces variables dans
# le dashboard Render (jamais de secrets dans Git).
# ============================================================================

# dev | prod | test
APP_ENV=dev

# Chaîne aléatoire longue : php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=

# MySQL — dev local (docker-compose) :
#   mysql://mybank_user:mybank@127.0.0.1:3306/mybank?serverVersion=8.0&charset=utf8mb4
# Production (MySQL managé, ex. Aiven) :
#   mysql://USER:PASSWORD@HOST:PORT/DBNAME?serverVersion=8.0&charset=utf8mb4
DATABASE_URL=

# Passphrase des clés JWT (génération : voir README_DEPLOYMENT.md)
JWT_PASSPHRASE=

# Origines autorisées (regex). Dev :
#   ^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$
# Production (domaine Vercel) :
#   ^https://mybank-frontend\.vercel\.app$
CORS_ALLOW_ORIGIN=
